# ================ 通用忽略规则 ================

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# 编辑器文件
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Python相关
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
env.local/
.env.*.local

# 日志文件
*.log
logs/

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 配置文件
.env
.env.local
.env.production
.env.staging
secrets/

# 上传文件
uploads/
*.tmp
*.temp

# 测试和覆盖报告
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# 构建和分发
dist/
build/
*.egg-info/
*.whl
*.egg

# Celery
celerybeat-schedule

# Jupyter Notebook
.ipynb_checkpoints

# Docker
docker-compose.override.yml

# ================ 项目特定规则 ================

# 作业上传文件
app/uploads/
uploads/

# 模型文件（如果有）
models/*.pkl
models/*.pt
models/*.h5

# 缓存文件
.cache/
