# ==============================================================================
# 作业智能批改系统 - 环境配置示例文件
# ==============================================================================
# 复制此文件为 .env 并修改配置值
# 本文件可以安全地提交到版本控制系统
# ==============================================================================

# --------------------------- 服务基础配置 --------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --------------------------- 数据库配置 ----------------------------------------
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/database_name?charset=utf8mb4
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=50
DB_POOL_RECYCLE=280
DB_ECHO=false

# --------------------------- Redis 配置 ----------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --------------------------- 阿里云服务配置 ------------------------------------
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ENABLE_ALIYUN_OCR=true

# --------------------------- DeepSeek 大模型配置（通过阿里云百炼 DashScope API）--
# 注意：DeepSeek-v4-pro 不支持 system 角色，所有系统提示词需合并到 user content
DASHSCOPE_API_KEY=your_dashscope_api_key
LLM_MODEL=deepseek-v4-pro
ENABLE_LLM=true
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# --------------------------- JWT 认证配置 --------------------------------------
JWT_SECRET_KEY=generate-a-strong-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------- 文件存储配置 --------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
IMAGE_COMPRESS_QUALITY=85
MAX_IMAGE_WIDTH=2048
MAX_IMAGE_HEIGHT=2048

# --------------------------- 日志配置 ------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# --------------------------- 跨域配置 ------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# --------------------------- 限流配置 ------------------------------------------
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# --------------------------- 异步任务配置 --------------------------------------
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_TIMEOUT=300
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# --------------------------- 安全配置 ------------------------------------------
SECURE_COOKIES=false
SESSION_COOKIE_NAME=session_id
CSRF_PROTECTION_ENABLED=false

# --------------------------- 应用配置 ------------------------------------------
APP_NAME=作业智能批改系统
APP_VERSION=1.0.0
APP_DESCRIPTION=基于AI的中小学作业智能批改系统