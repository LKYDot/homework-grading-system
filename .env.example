# ================ 服务配置 ================
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ================ 数据库配置 ================
# SQLite配置（开发环境）
DATABASE_URL=sqlite:///./homework_grading.db

# PostgreSQL配置（生产环境）
# DATABASE_URL=postgresql://postgres:password@localhost:5432/homework_grading

# ================ Redis配置 ================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ================ 阿里云服务配置 ================
# 前往阿里云控制台获取：https://ram.console.aliyun.com/
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_OCR_ENDPOINT=ocr.cn-shanghai.aliyuncs.com
ENABLE_ALIYUN_OCR=True

# ================ 通义千问配置 ================
# 前往阿里云控制台获取：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key
LLM_MODEL=qwen-turbo
ENABLE_LLM=True

# ================ JWT配置 ================
# 生成安全的密钥：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ================ 文件存储配置 ================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ================ 日志配置 ================
LOG_LEVEL=INFO
LOG_FILE=

# ================ 跨域配置 ================
CORS_ORIGINS=["*"]

# ================ 限流配置 ================
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
